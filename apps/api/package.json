{
  "name": "trackhub-api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "echo \"No build step for API\"",
    "lint": "echo \"No lint configured\"",
    "test": "node --test",
    "migrate:private-files": "node scripts/migrate-files-to-private.js",
    "gmail:auth": "node scripts/gmail-auth.js",
    "test:unit": "node --test test/security.test.js test/observability.test.js test/planLimits.test.js test/permissions.test.js test/features.test.js",
    "test:integration": "node --test --test-concurrency=1 test/collab.test.js test/dashboard.test.js test/explore.test.js test/feed.test.js test/home.test.js test/notifications.test.js test/passwordReset.test.js test/profile.test.js test/projects.test.js test/user.test.js",
    "migrate:deploy": "prisma migrate deploy",
    "db:check-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^11.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0",
    "supertest": "^6.3.4"
  }
}
