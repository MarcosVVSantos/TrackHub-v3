generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  light
  dark
}

enum ProjectStatus {
  idea
  in_progress
  production
  finished
}

enum MemberRole {
  owner
  editor
  viewer
}

enum InviteStatus {
  pending
  accepted
  declined
}

enum CalendarShareStatus {
  none
  pending
  accepted
  declined
}

enum TaskFlag {
  none
  attention
  blocked
}

enum NotificationType {
  invite
  project_invite
  project_invite_accept
  project_invite_decline
  project_removed
  calendar_invite
  calendar_accept
  calendar_decline
  event_created
  event_updated
  follow
  track_like
  track_comment
  track_save
  social_like
  social_comment
  social_save
  playlist_save
  comment
  upload
  status_change
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  username      String           @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  bio           String?
  isActive      Boolean          @default(true)
  theme         ThemePreference  @default(light)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  projectsOwned Project[]        @relation("ProjectOwner")
  memberships   ProjectMember[]  @relation("MemberUser")
  invitesSent   ProjectMember[]  @relation("MemberInviter")
  calendarInvitesSent ProjectMember[] @relation("CalendarInviter")
  comments      ProjectComment[]
  trackComments TrackComment[]
  trackLikes    TrackLike[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  notificationsSent Notification[] @relation("NotificationActor")
  fileUploads   FileAsset[]
  fileVersions  FileVersion[]
  following     Follow[]         @relation("UserFollowing")
  followers     Follow[]         @relation("UserFollowers")
  playlists     Playlist[]       @relation("PlaylistCreator")
  playlistSaves PlaylistSave[]
  trackSaves    TrackSave[]
  socialPosts   SocialPost[]     @relation("PostAuthor")
  socialLikes   SocialPostLike[]
  socialSaves   SocialPostSave[]
  socialComments SocialPostComment[]
  eventsCreated ProjectEvent[] @relation("EventCreator")
  eventParticipations ProjectEventParticipant[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus       @default(idea)
  order       Int                 @default(0)
  tags        Json?
  isPublic    Boolean             @default(false)
  coverUrl    String?
  archivedAt  DateTime?
  ownerId     String
  owner       User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members     ProjectMember[]
  tasks       TaskCard[]
  comments    ProjectComment[]
  statusLog   ProjectStatusLog[]
  files       FileAsset[]
  tracks      Track[]
  socialPosts SocialPost[]
  events      ProjectEvent[]
}

model ProjectMember {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  userId      String?
  user        User?        @relation("MemberUser", fields: [userId], references: [id])
  inviteEmail String
  role        MemberRole   @default(viewer)
  roleLabel   String?
  status      InviteStatus @default(pending)
  invitedById String
  invitedBy   User         @relation("MemberInviter", fields: [invitedById], references: [id])
  calendarShareStatus CalendarShareStatus @default(none)
  calendarInvitedById String?
  calendarInvitedBy   User?        @relation("CalendarInviter", fields: [calendarInvitedById], references: [id])
  createdAt   DateTime     @default(now())
}

model ProjectEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ProjectEventParticipant[]
}

model ProjectEventParticipant {
  id        String       @id @default(cuid())
  eventId   String
  event     ProjectEvent @relation(fields: [eventId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([eventId, userId])
}

model TaskCard {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  flag        TaskFlag @default(none)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model ProjectStatusLog {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  fromStatus ProjectStatus
  toStatus   ProjectStatus
  changedBy  String
  createdAt  DateTime      @default(now())
}

model FileAsset {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id])
  uploaderId String
  uploader   User         @relation(fields: [uploaderId], references: [id])
  name       String
  type       String
  url        String
  storageKey String
  createdAt  DateTime     @default(now())

  versions   FileVersion[]
}

model FileVersion {
  id        String   @id @default(cuid())
  fileId    String
  file      FileAsset @relation(fields: [fileId], references: [id])
  version   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Track {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  title       String
  description String?
  audioUrl    String
  coverUrl    String?
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  likes       TrackLike[]
  comments    TrackComment[]
  plays       TrackPlay[]
  saves       TrackSave[]
  playlistTracks PlaylistTrack[]
  socialPosts    SocialPost[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Playlist {
  id          String         @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  tags        Json?
  isPublic    Boolean        @default(true)
  creatorId   String
  creator     User           @relation("PlaylistCreator", fields: [creatorId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tracks      PlaylistTrack[]
  saves       PlaylistSave[]
  posts       SocialPost[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id])
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
}

model PlaylistSave {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([playlistId, userId])
}

model TrackSave {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([trackId, userId])
}

model SocialPost {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("PostAuthor", fields: [authorId], references: [id])
  content    String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  trackId    String?
  track      Track?   @relation(fields: [trackId], references: [id])
  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id])
  createdAt  DateTime @default(now())

  likes      SocialPostLike[]
  saves      SocialPostSave[]
  comments   SocialPostComment[]
}

model SocialPostLike {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model SocialPostSave {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model SocialPostComment {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime   @default(now())
}

model TrackLike {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model TrackComment {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model TrackPlay {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  type      NotificationType
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}
