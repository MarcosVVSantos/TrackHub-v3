PORT=4000
NODE_ENV="development"

# Banco PostgreSQL (local ou Neon/Supabase/Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/trackhub"

# Em produção use valores longos e aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change_me_access"
JWT_REFRESH_SECRET="change_me_refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

UPLOAD_DIR="uploads"
PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:5173"

# Cloudflare R2 (armazenamento de áudio e imagens)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="trackhub"
R2_PUBLIC_URL="https://<seu-dominio-publico-do-bucket>"
# Bucket SEM acesso público para os arquivos dos projetos (beats e versões não lançadas).
# O app gera links temporários assinados. Sem ele, os arquivos de projeto ficam no bucket público.
R2_PRIVATE_BUCKET="trackhub-private"
# Validade dos links assinados, em segundos.
SIGNED_URL_TTL_SECONDS=3600

# Monitoramento de erros (opcional): DSN do projeto no sentry.io
SENTRY_DSN=""
# Nível mínimo de log: debug, info, warn ou error
LOG_LEVEL="info"

# E-mail (redefinição de senha). Sem nenhuma opção configurada, o link aparece no log do servidor.
# Opção 1: Gmail API (cliente OAuth "App para computador" no Google Cloud; refresh token via `npm run gmail:auth`)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Opção 2: Brevo
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=TrackHub
